  "drug_name": "Ziihera (zanidatamab-hrii)",
  "drug_indication": "First-Line HER2-Positive Locally Advanced or Metastatic Gastroesophageal Adenocarcinoma",
  "airtable_id": 7545,
  "stage": "PDUFA priority review",
  "catalyst_date": "2026-04-27",
  "catalyst_source": "https://www.benzinga.com/pressreleases/26/04/n52058182/jazz-pharmaceuticals-announces-fda-acceptance-and-priority-review-of-supplemental-biologics-licens",
  "catalyst_text": "sBLA accepted with priority review PDUFA set 2026",
  "detailed_catalyst_text": "The FDA accepted for filing with Priority Review a supplemental BLA for first-line treatment of adults with HER2-positive unresectable locally advanced or metastatic gastric, gastroesophageal junction, or esophageal adenocarcinoma. A PDUFA target action date was set for 2026-08-25, and the submission is under Real-Time Oncology Review. This represents an expedited U.S. regulatory review milestone for this indication.",
  "catalyst_text_evidence": "\"announced that the U.S. Food and Drug Administration (FDA) accepted for filing with Priority Review the supplemental Biologics License Application (sBLA) for Ziihera... for the first-line treatment of adult patients with HER2-positive (HER2+) unresectable locally advanced or metastatic gastric, gastroesophageal junction (GEJ), or gastroesophageal adenocarcinoma (GEA).\" \"The FDA has set a PDUFA target action date of 2026-08-25.\" \"The submission is under review via the Real-Time Oncology Review (RTOR) program\"",
  "news_published_at": "2026-04-28T00:00:00Z",
  "open_price_gap_percent": "0.00835",
  "intra_day_price_change_percent": "0.01544"
