  "ticker": "VTRS",
  "drug_name": "MR-107A-02 (fast-acting meloxicam)",
  "drug_indication": "Moderate-to-severe acute pain",
  "airtable_id": 7749,
  "stage": "PDUFA",
  "catalyst_date": "2026-05-18",
  "catalyst_source": "https://www.prnewswire.com/news-releases/us-fda-accepts-viatris-new-drug-application-for-fast-acting-meloxicam-for-the-treatment-of-moderate-to-severe-acute-pain-302774276.html",
  "catalyst_text": "NDA accepted with PDUFA set December 27 2026",
  "detailed_catalyst_text": "The FDA accepted for review the NDA for a fast-acting meloxicam formulation for moderate-to-severe acute pain. Acceptance also established a PDUFA goal date of 2026-12-27, defining the timeline for the regulatory decision. This marks progression into formal FDA review for a potential non-opioid pain treatment.",
  "catalyst_text_evidence": "Viatris Inc. (NASDAQ:VTRS), a global healthcare company, today announced that the U.S. Food and Drug Administration (FDA) has accepted for review the New Drug Application (NDA) for MR-107A-02 (fast-acting meloxicam), a non-opioid, for the treatment of moderate-to-severe acute pain. The FDA has assigned a PDUFA goal date of 2026-12-27.",
  "news_published_at": "2026-05-19T00:00:00Z",
  "open_price_gap_percent": "0.00485",
  "intra_day_price_change_percent": "-0.00362"
 },
