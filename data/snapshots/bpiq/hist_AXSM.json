  "ticker": "AXSM",
  "drug_name": "Solriamfetol",
  "drug_indication": "Attention Deficit Hyperactivity Disorder",
  "airtable_id": 8395,
  "stage": "Phase 3",
  "catalyst_date": "2026-07-07",
  "catalyst_source": "https://www.globenewswire.com/news-release/2026/07/07/3323028/33090/en/axsome-therapeutics-initiates-focus-2-phase-3-trial-of-solriamfetol-in-children-with-attention-deficit-hyperactivity-disorder-adhd.html",
  "catalyst_text": "First patient dosed in Phase 3 pediatric trial",
  "detailed_catalyst_text": "The first patient was dosed in the FOCUS-2 Phase 3 trial evaluating solriamfetol for children aged 6 to less than 12 years with attention deficit hyperactivity disorder. This milestone initiates a randomized, double-blind, placebo-controlled, multicenter study with a primary endpoint of change from baseline to week 6 in ADHD-RS-5 total score, advancing late-stage development in pediatric ADHD.",
  "catalyst_text_evidence": "Axsome Therapeutics, Inc. (NASDAQ:AXSM), a biopharmaceutical company leading a new era in the treatment of central nervous system (CNS) disorders, today announced that the first patient has been dosed in the FOCUS-2 Phase 3 trial evaluating solriamfetol as a treatment for children with attention deficit hyperactivity disorder (ADHD). FOCUS-2 (Forward Treatment of Attention Deficit and Hyperactivity Using Solriamfetol) is a Phase 3, randomized, double-blind, placebo-controlled, multicenter trial to assess the efficacy and safety of solriamfetol in children aged 6 to less than 12 years with ADHD.",
  "news_published_at": "2026-07-08T00:00:00Z",
  "open_price_gap_percent": "-0.00120",
  "intra_day_price_change_percent": "0.03075"
 },
