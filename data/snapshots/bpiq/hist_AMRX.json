  "ticker": "AMRX",
  "drug_name": "Romidepsin injection solution",
  "drug_indication": "Cutaneous T-Cell Lymphoma",
  "airtable_id": 8058,
  "stage": "Approved",
  "catalyst_date": "2026-06-04",
  "catalyst_source": "https://www.globenewswire.com/news-release/2026/06/04/3306692/0/en/amneal-announces-u-s-fda-approval-of-romidepsin-injection-solution.html",
  "catalyst_text": "Received FDA approval for cutaneous T cell lymphoma",
  "detailed_catalyst_text": "The FDA approved a ready-to-use romidepsin injection solution (27.5 mg/5.5 mL) supplied in single-dose vials. It is indicated for adult patients with cutaneous T\u2011cell lymphoma after at least one prior systemic therapy and is eligible for Competitive Generic Therapy designation providing 180 days of market exclusivity. The ready-to-use presentation eliminates reconstitution steps, offering operational and safety advantages for providers.",
  "catalyst_text_evidence": "\u201cthe U.S. Food and Drug Administration (FDA) has approved the Company's romidepsin injection solution, 27.5 mg/5.5 mL, supplied in single-dose, ready-to-use vials.\u201d \u201cThe product is eligible for Competitive Generic Therapy (CGT) designation, which provides Amneal with 180 days of market exclusivity.\u201d \u201cRomidepsin injection solution is a histone deacetylase inhibitor indicated for the treatment of cutaneous T-cell lymphoma in adult patients who have received at least one prior systemic therapy.\u201d",
  "news_published_at": "2026-06-05T00:00:00Z",
  "open_price_gap_percent": "0.00971",
  "intra_day_price_change_percent": "0.04000"
 },
