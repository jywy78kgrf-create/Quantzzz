  "ticker": "AMRX",
  "drug_name": "Epinephrine Injection USP",
  "drug_indication": "Anaphylaxis, Septic Shock",
  "airtable_id": 6547,
  "stage": "Approved",
  "catalyst_date": "2025-12-09",
  "catalyst_source": "https://investors.amneal.com/news/press-releases/press-release-details/2025/Amneal-Receives-U-S--FDA-Approval-for-Epinephrine-Injection-in-Single--and-Multi-Dose-Vials-for-U-S--Hospitals/default.aspx",
  "catalyst_text": "Received FDA approval for anaphylaxis and septic shock",
  "detailed_catalyst_text": "The FDA approved epinephrine injection 1 mg/mL in single- and multi-dose vials. The label includes emergency treatment of allergic reactions including anaphylaxis and raising mean arterial blood pressure in adults with hypotension due to septic shock. This adds an essential hospital medicine in multiple vial presentations to support acute care settings.",
  "catalyst_text_evidence": "\u201cthe U.S. Food and Drug Administration (FDA) has approved the Company\u2019s epinephrine injection USP, 1 mg/mL (1 mL), in single-dose vials and 1 mg/mL (30 mL) multi-dose vials.\u201d \u201cThe 1 mg/mL formulation is indicated for the emergency treatment of allergic reactions (Type 1) including anaphylaxis, which may result from insect stings or bites, foods, drugs, sera, diagnostic testing substances and other allergens, as well as idiopathic anaphylaxis or exercise-induced anaphylaxis and to increase mean arterial blood pressure in adult patients with hypotension associated with septic shock.\u201d",
  "news_published_at": "2025-12-11T00:00:00Z",
  "open_price_gap_percent": "0.02022",
  "intra_day_price_change_percent": "-0.01156"
 },
