  "ticker": "AXSM",
  "drug_name": "Auvelity",
  "drug_indication": "Agitation associated with dementia due to Alzheimer's disease",
  "airtable_id": 7607,
  "stage": "Approved",
  "catalyst_date": "2026-04-30",
  "catalyst_source": "https://www.benzinga.com/pressreleases/26/04/g52187283/axsome-therapeutics-announces-fda-approval-of-auvelity-dextromethorphan-hbr-and-bupropion-hcl-for-",
  "catalyst_text": "Received FDA approval for Alzheimer agitation indication",
  "detailed_catalyst_text": "The FDA approved Auvelity for the treatment of agitation associated with dementia due to Alzheimer\u2019s disease. The decision was supported by a clinical program including the Phase 3 ADVANCE-1 and long-term ACCORD-2 studies demonstrating symptom improvement and longer time to relapse versus placebo. This provides a new treatment option for a prevalent and burdensome neuropsychiatric manifestation of Alzheimer\u2019s disease.",
  "catalyst_text_evidence": "Axsome Therapeutics, Inc. (NASDAQ:AXSM)\u2026 today announced that the U.S. Food and Drug Administration (FDA) has approved AUVELITY (dextromethorphan HBr and bupropion HCl) for the treatment of agitation associated with dementia due to Alzheimer's disease. The FDA approval of AUVELITY for agitation associated with dementia due to Alzheimer's disease is supported by a comprehensive clinical program which included the Phase 3 ADVANCE-1 and ACCORD-2 studies. AUVELITY was developed with FDA Breakthrough Therapy designation and evaluated by the FDA under Priority Review.",
  "news_published_at": "2026-05-02T00:00:00Z",
  "open_price_gap_percent": "0.00179",
  "intra_day_price_change_percent": "0.12736"
 },
 {
