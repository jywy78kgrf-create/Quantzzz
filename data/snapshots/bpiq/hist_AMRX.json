  "updated_at": "2026-06-30T13:09:02.929683Z",
  "ticker": "AMRX",
  "drug_name": "CREXONT",
  "drug_indication": "Parkinson's Disease",
  "airtable_id": 8064,
  "stage": "Approved",
  "catalyst_date": "2026-06-05",
  "catalyst_source": "https://www.benzinga.com/pressreleases/26/06/g53024113/amneal-announces-full-study-population-interim-phase-4-elevate-pd-results-reinforcing-previously-r",
  "catalyst_text": "Announced positive interim results and FDA labeling update",
  "detailed_catalyst_text": "New interim Phase 4 ELEVATE-PD data in adults with Parkinson's disease showed increased Good On time, reduced Off time, and improved motor function after switching. Results from 214 patients were presented at a neurology congress, supporting more predictable symptom control versus prior regimens. Additionally, the FDA recently approved a labeling update allowing capsule contents to be sprinkled on applesauce for patients with swallowing difficulties.",
  "catalyst_text_evidence": "\"Amneal Pharmaceuticals, Inc. (NASDAQ:AMRX) ('Amneal' or the 'Company'), today announced new positive interim results from its ongoing Phase 4 ELEVATE-PD study, which are being presented at the Advanced Therapeutics in Movement & Related Disorders 2026 Congress on 2026-06-05.\" \"The entire study population (n=214) evaluated after six weeks of treatment demonstrated substantial clinical benefit after switching to CREXONT... After patients switched from prior therapies, treatment with CREXONT delivered meaningful increases in 'Good On' time, reductions in 'Off' time, and improved motor symptom control.\" \"In May 2026, the FDA approved a labeling update providing an additional administration option for patients who have difficulty swallowing intact capsules, who may now take CREXONT by carefully opening and sprinkling the capsule contents on a small amount of applesauce, which should be immediately consumed.\"",
  "news_published_at": "2026-06-06T00:00:00Z",
  "open_price_gap_percent": "0.00444",
  "intra_day_price_change_percent": "0.01252"
 },
 {
