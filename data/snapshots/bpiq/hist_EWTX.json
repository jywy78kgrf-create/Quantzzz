  "ticker": "EWTX",
  "drug_name": "EDG-7500",
  "drug_indication": "Obstructive Hypertrophic Cardiomyopathy, Nonobstructive Hypertrophic Cardiomyopathy",
  "airtable_id": 8205,
  "stage": "Phase 2",
  "catalyst_date": "2026-06-16",
  "catalyst_source": "https://www.prnewswire.com/news-releases/edgewise-therapeutics-announces-positive-top-line-data-from-12-week-phase-2-cirrus-hcm-trial-with-edg-7500-in-obstructive-and-nonobstructive-hypertrophic-cardiomyopathy-hcm-302801108.html",
  "catalyst_text": "Announced positive topline results from Phase 2 study",
  "detailed_catalyst_text": "Reported positive top-line 12-week Phase 2 Part D results in patients with obstructive and nonobstructive hypertrophic cardiomyopathy. Data showed clinically meaningful improvements across hemodynamics, biomarkers, symptoms, and function with no meaningful LVEF reductions and a generally well-tolerated profile. These findings support a differentiated safety and efficacy profile in HCM and inform the next stage of development.",
  "catalyst_text_evidence": "BOULDER, Colo., 2026-06-16 /PRNewswire/ -- Edgewise Therapeutics, Inc. (NASDAQ:EWTX), a leading muscle disease biopharmaceutical company, today announced positive top-line results from the 12-week Phase 2 Part D CIRRUS-HCM trial of EDG-7500 in obstructive (oHCM) and nonobstructive (nHCM) HCM. EDG-7500 was generally well tolerated in Part D patients (n=53) and there were no new safety signals identified. There were no meaningful changes in left ventricular ejection fraction (LVEF) or reductions in LVEF to below 50%.",
  "news_published_at": "2026-06-17T00:00:00Z",
  "open_price_gap_percent": "0.01406",
  "intra_day_price_change_percent": "-0.04915"
 },
