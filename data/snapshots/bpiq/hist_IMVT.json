  "ticker": "IMVT",
  "drug_name": "Batoclimab",
  "drug_indication": "Thyroid Eye Disease",
  "airtable_id": 7362,
  "stage": "Phase 3",
  "catalyst_date": "2026-04-02",
  "catalyst_source": "https://www.globenewswire.com/news-release/2026/04/02/3267162/0/en/Immunovant-Announces-Phase-3-Study-Results-for-Batoclimab-in-Thyroid-Eye-Disease-TED.html",
  "catalyst_text": "Announced negative topline results in Phase 3 trials",
  "detailed_catalyst_text": "Topline results from two Phase 3 studies in adults with active, moderate-to-severe thyroid eye disease showed the trials failed to meet the prespecified primary endpoint of \u22652 mm proptosis responder rate at Week 24 following high-dose then low-dose treatment. Safety was consistent with prior findings with no new signals. This negative Phase 3 outcome materially impacts the program\u2019s prospects in thyroid eye disease.",
  "catalyst_text_evidence": "DURHAM, N.C., 2026-04-02 (GLOBE NEWSWIRE) -- Immunovant, Inc. (NASDAQ:IMVT), a clinical-stage immunology company dedicated to enabling normal lives for people with autoimmune diseases, today reported the topline results from its two Phase 3 (GO) clinical studies evaluating batoclimab as an investigational treatment for adults with active, moderate-to-severe thyroid eye disease (TED). Based on the pre-specified statistical analysis plan, the studies failed to meet their primary endpoint of \u22652mm proptosis responder rate at Week 24, following 12 weeks of high-dose and 12 weeks of low-dose batoclimab treatment. Safety results were consistent with previous findings, and no new safety signals were identified.",
  "news_published_at": "2026-04-03T00:00:00Z",
  "open_price_gap_percent": "-0.05339",
  "intra_day_price_change_percent": "0.03115"
 },
