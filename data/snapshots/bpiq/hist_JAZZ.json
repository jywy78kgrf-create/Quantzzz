  "ticker": "JAZZ",
  "drug_name": "Xywav",
  "drug_indication": "Narcolepsy",
  "airtable_id": 7400,
  "stage": "Approved",
  "catalyst_date": "2026-04-09",
  "catalyst_source": "https://www.prnewswire.com/news-releases/jazz-pharmaceuticals-to-present-research-on-epidiolex-cannabidiol-and-xywav-calcium-magnesium-potassium-and-sodium-oxybates-oral-solution-at-the-2026-american-academy-of-neurology-annual-meeting-302737503.html",
  "catalyst_text": "Reported improved functioning at higher nightly doses",
  "detailed_catalyst_text": "An analysis from the open-label, single-arm DUET study in adults with narcolepsy found that dosages greater than 9 grams per night were associated with improvements in cognitive complaints, daily functioning, work productivity, and overall disease burden compared with 9 grams per night. These results provide new clinical insight on dose optimization within studied ranges for patients with narcolepsy.",
  "catalyst_text_evidence": "A poster presentation featuring an analysis of adults with narcolepsy from the open-label, single-arm DUET (Develop hypersomnia Understanding by Evaluating low-sodium oxybate Treatment) study evaluating changes in cognitive complaints, daily functioning, work productivity and overall disease burden in patients treated with Xywav dosages >9 grams per night. Improvements in these outcomes were observed in participants who optimized their Xywav dosage to >9 grams per night (up to 12 grams total) when compared to a 9 gram per night dosage.",
  "news_published_at": "2026-04-10T00:00:00Z",
  "open_price_gap_percent": "-0.00750",
  "intra_day_price_change_percent": "0.01892"
 },
