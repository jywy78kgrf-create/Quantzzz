  "drug_name": "Epidiolex",
  "drug_indication": "Lennox-Gastaut Syndrome, Dravet Syndrome, Tuberous Sclerosis Complex, Other Refractory Epilepsies",
  "airtable_id": 7401,
  "stage": "Approved",
  "catalyst_date": "2026-04-09",
  "catalyst_source": "https://www.prnewswire.com/news-releases/jazz-pharmaceuticals-to-present-research-on-epidiolex-cannabidiol-and-xywav-calcium-magnesium-potassium-and-sodium-oxybates-oral-solution-at-the-2026-american-academy-of-neurology-annual-meeting-302737503.html",
  "catalyst_text": "Reported factors influencing persistence in refractory epilepsies",
  "detailed_catalyst_text": "A claims-based poster analyzed sociodemographic and clinical factors associated with persistence on therapy among more than 7,800 patients with Lennox-Gastaut syndrome, Dravet syndrome, tuberous sclerosis complex, or other refractory epilepsies. The findings highlight care variability and factors that may influence whether patients remain on treatment, informing efforts to support treatment continuity.",
  "catalyst_text_evidence": "A poster presentation detailing sociodemographic and clinical factors associated with persistence on Epidiolex among patients with LGS, DS, TSC, or other refractory epilepsies, based on claims analysis. This analysis of over 7,800 patients demonstrates how care variability in a non-standardized and fragmented care environment like epilepsy sheds light on the key factors that may influence whether patients remain on treatment and may help clinicians support treatment continuity.",
  "news_published_at": "2026-04-10T00:00:00Z",
  "open_price_gap_percent": "-0.00750",
  "intra_day_price_change_percent": "0.01892"
