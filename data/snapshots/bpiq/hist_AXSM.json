  "ticker": "AXSM",
  "drug_name": "AXS-14 (esreboxetine)",
  "drug_indication": "Fibromyalgia",
  "airtable_id": 6813,
  "stage": "Phase 3",
  "catalyst_date": "2026-01-15",
  "catalyst_source": "https://www.globenewswire.com/news-release/2026/01/15/3219394/33090/en/Axsome-Therapeutics-Initiates-FORWARD-Phase-3-Trial-of-AXS-14-for-the-Management-of-Fibromyalgia.html",
  "catalyst_text": "First patient dosed in Phase 3 trial",
  "detailed_catalyst_text": "First patient dosing occurred in the FORWARD Phase 3 randomized withdrawal trial evaluating AXS-14 for fibromyalgia. The study features a 12-week open-label period followed by randomized, double-blind withdrawal, with time to loss of therapeutic response as the primary endpoint. This marks advancement of the program into a late-stage study for a condition with limited therapies.",
  "catalyst_text_evidence": "NEW YORK, 2026-01-15 (GLOBE NEWSWIRE) -- Axsome Therapeutics, Inc. (NASDAQ:AXSM), a biopharmaceutical company leading a new era in the treatment of central nervous system (CNS) disorders, today announced the first patient has been dosed in the FORWARD Phase 3 trial of AXS-14 (esreboxetine) for the management of fibromyalgia. FORWARD (Fibromyalgia Response with Esreboxetine Evaluated Using a Randomized Withdrawal Research Design) is a Phase 3, double-blind, placebo-controlled, multicenter, randomized withdrawal trial in patients with fibromyalgia consisting of an open-label AXS-14 treatment period and a randomized, double-blind treatment period.",
  "news_published_at": "2026-01-16T00:00:00Z",
  "open_price_gap_percent": "0.00000",
  "intra_day_price_change_percent": "-0.01621"
 },
