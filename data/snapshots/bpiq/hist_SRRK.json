  "airtable_id": 7335,
  "stage": "BLA Filing",
  "catalyst_date": "2026-03-31",
  "catalyst_source": "https://www.businesswire.com/news/home/20260331950583/en/Scholar-Rock-Resubmits-Biologics-License-Application-BLA-to-FDA-for-Apitegromab-for-Treatment-of-Children-and-Adults-with-Spinal-Muscular-Atrophy-SMA",
  "catalyst_text": "Resubmitted BLA after prior FDA complete response letter",
  "detailed_catalyst_text": "The company resubmitted its BLA to the FDA for treatment of spinal muscular atrophy, following a previous Complete Response Letter that was tied to third\u2011party facility observations not specific to the product. The resubmission also includes a second U.S.-based fill-finish facility aligned with FDA discussions. This advances the program back into regulatory review while addressing prior inspection-related issues.",
  "catalyst_text_evidence": "\"Scholar Rock ... today announced it has resubmitted the Biologics License Application (BLA) for apitegromab for the treatment of children and adults with SMA to the U.S. Food and Drug Administration (FDA).\" \"In September 2025, Scholar Rock received a Complete Response Letter (CRL) from the FDA for apitegromab related to observations identified during a routine general site inspection of Catalent Indiana, LLC (part of Novo Nordisk).\" \"The observations were not specific to apitegromab and the CRL did not cite any other approvability concerns.\" \"The apitegromab BLA resubmission also includes a second U.S.-based fill-finish facility to strengthen the apitegromab supply chain and support future growing demand across the planned global commercial footprint.\"",
  "news_published_at": "2026-04-01T00:00:00Z",
  "open_price_gap_percent": "0.10655",
  "intra_day_price_change_percent": "0.03126"
 },
