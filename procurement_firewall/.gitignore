# runtime audit output from the CLI (regenerated per run)
audit_log.jsonl
*.audit.jsonl

# python
__pycache__/
*.pyc
.pytest_cache/

# LLM judge response cache (reproducible from the API; not a deliverable)
eval/.judge_cache.json
eval/.judge_cache.json.tmp

# bulk real-data cache — public data, large, and regenerable with
