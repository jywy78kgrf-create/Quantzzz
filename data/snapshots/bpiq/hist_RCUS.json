  "ticker": "RCUS",
  "drug_name": "Casdatifan",
  "drug_indication": "Clear Cell Renal Cell Carcinoma",
  "airtable_id": 6999,
  "stage": "Phase 1b",
  "catalyst_date": "2026-02-23",
  "catalyst_source": "https://www.businesswire.com/news/home/20260223145191/en/Arcus-Presents-New-Data-for-its-HIF-2a-Inhibitor-Casdatifan-Which-Showed-Progression-Free-Survival-Beyond-One-Year-in-Late-Line-Kidney-Cancer",
  "catalyst_text": "Reported positive updated Phase 1b renal cancer data",
  "detailed_catalyst_text": "Updated efficacy and biomarker results from the Phase 1/1b ARC-20 trial in late-line metastatic clear cell renal cell carcinoma were reported. The 100 mg QD tablet cohort showed mPFS of 15.1 months and cORR of 45%, with pooled cohorts showing cORR of 35% and mPFS of 12.2 months; biomarker analyses linked depth and durability of sEPO suppression with clinical benefit. These findings support the therapeutic potential of the HIF-2a inhibitor in this setting.",
  "catalyst_text_evidence": "Arcus Biosciences, Inc. (NYSE:RCUS), a clinical-stage, global biopharmaceutical company focused on developing differentiated molecules for patients with cancer and inflammatory and autoimmune diseases, today announced a new analysis of efficacy and biomarker data for casdatifan, a HIF-2a inhibitor with best-in-class potential, in late-line metastatic clear cell renal cell carcinoma (ccRCC) from the Phase 1/1b ARC-20 study. Median progression-free survival (mPFS) was 15.1 months, and the confirmed overall response rate (cORR) increased to 45% for the 100mg QD (once daily) tablet cohort in an updated analysis of the ARC-20 study. An updated analysis was conducted for efficacy with a DCO of 2026-01-30. New biomarker data demonstrated correlation between magnitude and durability of serum erythropoietin (sEPO) suppression by casdatifan and clinical benefit, including cORR and PFS.",
  "news_published_at": "2026-02-25T00:00:00Z",
  "open_price_gap_percent": "0.01211",
  "intra_day_price_change_percent": "-0.01925"
 },
