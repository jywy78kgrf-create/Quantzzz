# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Alpha Vantage — price/quote data (required for live data refresh; offline snapshots work without it)
ALPHA_VANTAGE_API_KEY=

# BPIQ — biotech catalyst data (https://api.bpiq.com/api/v1/, Token auth)
BPIQ_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact info
EDGAR_USER_AGENT=Quantzzz research bot contact@example.com

# Optional: enables the LLM advisor layer (strategy proposals + journal reviews)
ANTHROPIC_API_KEY=

# Real trading is OFF unless this is exactly "true" AND a broker key is set.
LIVE_TRADING=false
ALPACA_API_KEY=
ALPACA_API_SECRET=
