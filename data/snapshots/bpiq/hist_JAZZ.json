  "ticker": "JAZZ",
  "drug_name": "Epidiolex",
  "drug_indication": "Tuberous Sclerosis Complex-associated seizures",
  "airtable_id": 7399,
  "stage": "Phase 3",
  "catalyst_date": "2026-04-09",
  "catalyst_source": "https://www.prnewswire.com/news-releases/jazz-pharmaceuticals-to-present-research-on-epidiolex-cannabidiol-and-xywav-calcium-magnesium-potassium-and-sodium-oxybates-oral-solution-at-the-2026-american-academy-of-neurology-annual-meeting-302737503.html",
  "catalyst_text": "Reported positive six month behavioral outcomes in TSC",
  "detailed_catalyst_text": "Results from a prespecified six-month intermediate analysis of the ongoing EpiCom Phase 3b/4 study in patients with tuberous sclerosis complex-associated seizures were reported. Reductions in caregiver- and clinician-reported behavioral problems were observed with improvements across TAND-SQ, ABC subscales, and CGI-S measures. These post-approval data add evidence on neuropsychiatric outcomes relevant to this population.",
  "catalyst_text_evidence": "An oral presentation showcasing results from the prespecified 6-month intermediate analysis of the ongoing EpiCom Phase 3b/4 study demonstrated reductions in the severity of caregiver- and clinician-reported behavioral problems at 26 weeks after Epidiolex treatment initiation in patients with TSC-associated seizures. Improvements were seen across the TSC-Associated Neuropsychiatric Disorders Self-Report Quantified Checklist (TAND-SQ), Aberrant Behavior Checklist (ABC) subscale scores and Caregiver- and Clinician-Global Impression of Severity (CGI-S) scales.",
  "news_published_at": "2026-04-10T00:00:00Z",
  "open_price_gap_percent": "-0.00750",
  "intra_day_price_change_percent": "0.01892"
 },
